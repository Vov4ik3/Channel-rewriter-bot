# Copy this file to .env and fill in the values.

# ---- Required -------------------------------------------------------------

# From https://my.telegram.org -> API development tools (use the reader account)
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Channels to watch, comma-separated: @usernames, t.me links, or numeric ids.
# The reader account must be subscribed to them. login.py prints the list.
SOURCE_CHANNELS=@channel_one,@channel_two

# Where rewritten posts go: @username or numeric id (like -1001234567890)
TARGET_CHAT=-1001234567890

# ---- AI provider (pick one) ------------------------------------------------

# gemini | openai | deepseek | claude | local
# Leave everything in this section blank and, the first time the bot starts
# (needs BOT_TOKEN + ADMIN_ID below), it DMs you a picker that explains what
# each one needs. Change anytime via /settings > AI Provider.
AI_PROVIDER=

# Overrides the model for whichever provider is picked. Blank = a sensible
# default per provider (also changeable via /settings).
AI_MODEL=

# Gemini - free, no card needed: aistudio.google.com -> Get API key
GEMINI_API_KEY=

# OpenAI (ChatGPT) - paid: platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek - paid, cheap: platform.deepseek.com
DEEPSEEK_API_KEY=

# Claude (Anthropic) - paid: console.anthropic.com
ANTHROPIC_API_KEY=

# Local (self-hosted, e.g. Ollama) - needs an OpenAI-compatible /v1 endpoint,
# not a key. LOCAL_API_KEY only matters if your server actually checks it.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=local

# ---- Optional: post through a normal bot instead of the reader account ----

# From @BotFather. If set, posts come from the bot (it must be admin/member of
# TARGET_CHAT). If empty, the reader account posts itself.
BOT_TOKEN=

# ---- Optional: review mode ------------------------------------------------

# 1 = the bot DMs you each draft with Post / Rewrite / Skip buttons.
# Needs BOT_TOKEN, and you must press Start in the bot's chat once.
REVIEW_MODE=1
# Your own Telegram user id (ask @userinfobot). Also unlocks /status.
ADMIN_ID=0

# ---- Optional: tuning -----------------------------------------------------

# Posts shorter than this (in characters) are ignored
MIN_TEXT_LENGTH=50
# Re-post the original's photos/videos with the new text
INCLUDE_MEDIA=1
# Bots can upload up to 50 MB; bigger files are dropped
MAX_MEDIA_MB=45
# Pause between AI requests (Gemini's free tier allows ~10-15/minute; raise
# this if you're on a rate-limited plan with another provider)
AI_DELAY_SECONDS=6

# ---- Optional: daily summary (needs BOT_TOKEN and ADMIN_ID) ---------------

# 1 = once a day the bot DMs you "Show summary" / "Not today"
DAILY_SUMMARY=1
# Hour to send that prompt, 0-23, UTC
DAILY_SUMMARY_HOUR_UTC=18

# ---- Optional: bot language -------------------------------------------

# en or ru. Leave blank and, the first time the bot starts (needs BOT_TOKEN
# + ADMIN_ID), it DMs you a language picker. Change anytime via /settings.
LANG=
